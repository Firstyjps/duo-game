[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://systems/audio/debug/audio_sandbox.gd" id="1_sandbox"]
[ext_resource type="PackedScene" path="res://systems/audio/audio_director.tscn" id="2_director"]

[node name="AudioSandbox" type="Node2D"]
